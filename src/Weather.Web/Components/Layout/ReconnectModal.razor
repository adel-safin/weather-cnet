@* Оверлей потери канала InteractiveServer - разметка задана Blazor: идентификаторы и классы состояний менять нельзя, их выставляет клиентский скрипт - локализованы тексты, оформление приведено к теме приложения *@

<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

<dialog id="components-reconnect-modal" data-nosnippet lang="ru">
    <div class="components-reconnect-container">
        <div class="components-rejoining-animation" aria-hidden="true">
            <div></div>
            <div></div>
        </div>
        <p class="components-reconnect-first-attempt-visible">
            Восстанавливаем соединение с сервером…
        </p>
        <p class="components-reconnect-repeated-attempt-visible">
            Соединение потеряно. Следующая попытка через
            <span id="components-seconds-to-next-attempt"></span> с.
        </p>
        <p class="components-reconnect-failed-visible">
            Не удалось восстановить соединение.<br />Повторите попытку или обновите страницу.
        </p>
        <button id="components-reconnect-button" class="components-reconnect-failed-visible">
            Повторить
        </button>
        <p class="components-pause-visible">
            Сеанс приостановлен сервером.
        </p>
        <p class="components-resume-failed-visible">
            Не удалось продолжить сеанс.<br />Повторите попытку или обновите страницу.
        </p>
        <button id="components-resume-button" class="components-pause-visible components-resume-failed-visible">
            Продолжить
        </button>
    </div>
</dialog>
