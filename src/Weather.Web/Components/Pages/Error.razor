@page "/Error"
@using System.Diagnostics

<PageTitle>Ошибка</PageTitle>

<main class="page">
    <header class="page__header">
        <div>
            <p class="page__eyebrow">Ошибка</p>
            <h1 class="page__title">Что-то пошло не так</h1>
            <p class="page__subtitle">
                Запрос не удалось обработать. Попробуйте вернуться к прогнозу и повторить действие.
            </p>
            @if (ShowRequestId)
            {
                <p class="page__subtitle">Идентификатор запроса: <code>@RequestId</code></p>
            }
        </div>

        <a class="button button--primary" href="/">К прогнозу</a>
    </header>
</main>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }

    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
